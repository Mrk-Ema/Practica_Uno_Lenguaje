// Comentario de linea: esto no genera tokens
@modelo "claude-sonnet-4-6"
@rol "analista financiero"
AGENTE analista {
/* comentario
   de bloque */
contexto = "Eres un analista"
variable ventas = CARGAR("ventas.csv")
PREGUNTAR "Que paso?" SOBRE ventas -> datos
variable total = 1 + 2
PREGUNTAR "cadena sin cerrar
variable mal = 5 & 3
}